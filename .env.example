# Copy to .env and fill in. For local Postgres both URLs can be the same.
# On a hosted DB (Neon, Supabase, Vercel Postgres): DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodpalace?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/foodpalace?schema=public"

# Used ONCE by `npm run db:seed` to create the first owner account (only if no users exist).
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Realtime (Supabase Realtime Broadcast). Optional: without these the POS and tracking page just check for updates every few seconds.
# Create a free project at supabase.com, then Project Settings > API: copy the Project URL and the anon public key.
# No tables or SQL are needed. Supabase is only used to push "an order changed" messages. Your orders stay in your own database.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Optional, server only (never expose): lets the server send messages with the service key instead of the anon key.
# SUPABASE_SERVICE_ROLE_KEY=""
