{
  "name": "food-palace-pos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:guards": "prisma db execute --file prisma/sql/immutability.sql --schema prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "db:check": "tsx --env-file=.env scripts/check.ts",
    "db:setup": "prisma migrate deploy && npm run db:guards && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.47.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
